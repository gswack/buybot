# Get your API key at https://serpapi.com (free tier: 100 searches/month)
SERPAPI_KEY=your_serpapi_key_here

# Get your token at https://console.apify.com/settings/integrations
# Used for the ASOS scraper — leave blank to disable ASOS results
APIFY_API_TOKEN=your_apify_token_here

# How many results to return per search
TOP_K=10
