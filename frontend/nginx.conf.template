# Nginx config for the frontend container.
# Serves the built Vite static site and reverse-proxies /api to the FastAPI
# backend over the VNet. BACKEND_URL is substituted at container start from an
# environment variable (e.g. http://10.0.0.133:8000) via `envsubst`.
server {
    listen 3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Static SPA: fall back to index.html for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }     proxy_set_header X-Real-IP $remote_addr;
sddd


dd        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
 proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Image uploads can be large (phone photos 5-15MB); allow plenty and
        # stream the body straight through instead of buffering/rejecting it.
        client_max_body_size 50m;
        client_body_buffer_size 1m;
        proxy_request_buffering off;

        # Lens lookups can be slow upstream.
        proxy_connect_timeout 15s;
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
    }
}
