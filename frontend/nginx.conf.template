# Nginx config for the frontend container.
# Serves the built Vite static site and reverse-proxies /api to the FastAPI
# backend over the VNet. BACKEND_URL is substituted at container start from an
# environment variable (e.g. http://10.0.0.133:8000) via `envsubst`.
server {
    listen 3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Static SPA: fall back to index.html for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API calls to the backend. The frontend calls same-origin "/api",
    # so the browser never talks to the private backend directly.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Image uploads can be large; allow a generous body size.
        client_max_body_size 25m;
        proxy_read_timeout 120s;
    }
}
